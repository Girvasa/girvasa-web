# ==============================================================================
# Girvasa Web Admin Portal - Environment Configuration Template
# Copy to .env.local for local development. Never commit real credentials!
# ==============================================================================

# Backend REST API Base URL (accessible from the browser client)
# Note: Next.js exposes variables prefixed with NEXT_PUBLIC_ to the browser bundle.
# Never prefix sensitive server-side secrets with NEXT_PUBLIC_!
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Runtime port (Default: 3000)
PORT=3000
